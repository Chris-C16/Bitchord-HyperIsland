<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base circolare traslucida + bordo glass -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#30FFFFFF"
                android:centerColor="#1CFFFFFF"
                android:endColor="#12FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Leggero riflesso luminoso nella parte superiore -->
    <item
        android:bottom="14dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
